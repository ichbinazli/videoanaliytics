# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env git'e ASLA girmez (kök .gitignore).

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# docker-compose.yml'deki MySQL. Prod'da yönetilen bir sunucuya işaret eder.
DATABASE_URL="mysql://va:va@localhost:3307/video_analytics?connectionLimit=10"

# --- Kullanıcı oturumu ---------------------------------------------------
# Üretmek için: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-change-me-dev-only-change-me-dev-only!!"
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Cookie ayarları. Prod'da COOKIE_SECURE=true zorunludur.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Cihaz API key'leri --------------------------------------------------
# Key hash'lerine karışan HMAC pepper'ı. DEĞİŞTİRİLİRSE TÜM CİHAZ KEY'LERİ GEÇERSİZ OLUR.
# Üretmek için: openssl rand -base64 48
API_KEY_PEPPER="dev-only-change-me-pepper-dev-only-change-me-pep"

# --- Panel origin'leri ---------------------------------------------------
# Virgülle ayrılmış. Hem CORS hem CSRF (Origin allowlist) için kullanılır.
# /ingest/* route'ları bunu yok sayar — cihazlar tarayıcı değildir.
CORS_ORIGINS=http://localhost:3000

# --- Veri toplama --------------------------------------------------------
INGEST_MAX_BATCH=500
# Cihaz saatleri kayabilir: bu pencerenin dışındaki oturumlar batch'i düşürmez,
# `rejected` listesinde raporlanır.
INGEST_CLOCK_SKEW_FUTURE_HOURS=48
INGEST_CLOCK_SKEW_PAST_DAYS=90
INGEST_RATE_LIMIT_PER_MINUTE=60

# --- Zamanlanmış işler ---------------------------------------------------
ROLLUP_CRON="*/5 * * * *"
RAW_RETENTION_DAYS=180
